# ---- 本地虚拟环境与打包产物 ----
.venv/
build/*
dist/
dist-diag/
__pycache__/
*.py[cod]

# 随手写的 spec 不入库，但打包配置是项目文件，要跟着仓库走，方便别人自己打 exe
*.spec
!build/app.spec

# ---- 本地运行数据：含本机 IP / 端口 / 哔哩哔哩 Cookie，绝不入库 ----
config.json
*.log
err.txt
samples/hls/
samples/short_2s.mp4

# ---- 编辑器与系统 ----
.idea/
.vscode/
Thumbs.db
desktop.ini

# ---- AI 助手运行时 ----
.workbuddy/
